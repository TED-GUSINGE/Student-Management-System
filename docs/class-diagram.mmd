classDiagram
    class Person {
        -int rollNo
        -string name
        +Person(int, string)
        +getRollNo()
        +getName()
        +display()*
    }

    class Student {
        -string course
        -float marks
        +Student(int, string, string, float)
        +getGrade()
        +updateDetails()
        +display()
    }

    class StudentManagement {
        -vector~Student~ students
        -findStudent(int)
        -saveToFile()
        -loadFromFile()
        +addStudent()
        +displayStudents()
        +searchStudent()
        +updateStudent()
        +deleteStudent()
    }

    Person <|-- Student : inherits
    StudentManagement o-- "0..*" Student : stores
